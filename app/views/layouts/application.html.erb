<!DOCTYPE html>
<html>
  <head>
    <title>Project Critics</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="desktop-wrapper">
      <div class="phone-frame">
        <div class="phone-screen">
          <div class="app-container">
            <header>
              <div class="container">
                <div class="header navbar shadow--gray" data-controller="menu">
                  <%= link_to image_tag("logo.png"), games_path, class: "navbar__logo" %>

                  <button class="menu-toggle" data-action="click->menu#toggle" aria-label="Menu">
                    <%= image_tag "hamburguer-icon-menu.svg", data: { menu_target: "openIcon" }, class: "menu-icon" %>
                    <%= image_tag "close-icon-menu.svg", data: { menu_target: "closeIcon" }, class: "menu-icon hidden" %>
                  </button>

                  <div class="menu-dropdown" data-menu-target="dropdown">
                    <% if user_signed_in? %>
                      <nav class="menu-nav">
                        <%= link_to "Profile", edit_user_registration_path, class: "menu-link", data: { action: "click->menu#close" } %>
                        <%= link_to "Games", games_path, class: "menu-link", data: { action: "click->menu#close" } %>
                        <%= link_to "Companies", companies_path, class: "menu-link", data: { action: "click->menu#close" } %>
                      </nav>
                      <div class="menu-footer">
                        <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "button button--secondary button--full" %>
                      </div>
                    <% else %>
                      <div class="menu-guest">
                        <p class="menu-guest-text">Sign in to start criting games and companies</p>
                        <%= link_to "Sign in", new_user_session_path, class: "button button--primary button--full" %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </header>
            <section class="section">
              <div class="container">
                <p class="notice"><%= notice %></p>
                <p class="alert"><%= alert %></p>
                <%= yield %>
              </div>
            </section>
            <footer class="footer">
              <div class="footer__content">
                <h4>© 2023 - Codeable Critics</h4>
                <h4>Build with ♥ by</h4>
                <p>♤Marlon Salazar</p>
              </div>
            </footer>
          </div>
        </div>
      </div>
      <div class="desktop-branding">
        <h2>Codeable Critics</h2>
        <p>App optimizada para dispositivos moviles</p>
      </div>
    </div>
  </body>
</html>
